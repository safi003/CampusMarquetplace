# Copie ce fichier vers .env.prod sur le VPS puis remplis les valeurs :
#   cp .env.prod.example .env.prod
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Domaine qui pointe (enregistrement DNS A) vers l'IP publique du VPS.
# Caddy generera le certificat HTTPS automatiquement.
API_DOMAIN=api.tondomaine.com

# Base de donnees Neon (deja existante)
DATABASE_URL=postgresql://neondb_owner:xxx@ep-xxx-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Genere un secret fort : openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Identifiants RustFS (NE PAS garder admin/motdepasse123 en prod !)
# Genere : openssl rand -hex 16 pour chacun
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=campus-marketplace
RUSTFS_REGION=us-east-1

# OAuth Google
GOOGLE_CLIENT_ID=

# Origines autorisees par le CORS = domaine(s) du front sur Vercel
CORS_ORIGINS=https://campus-marketplace.vercel.app,https://tondomaine.com
