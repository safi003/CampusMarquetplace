// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CardStatus {
  PENDING
  APPROVED
  REJECTED
}
enum DeliveryMode {
  DIRECT
  HAND_DELIVERY
}
//ajout
enum OrderStatus {
  PENDING     // en file d'attente derrière une réservation active
  ACTIVE      // réservation en cours pour ce client, chrono lancé
  EXPIRED     // 15 min dépassées sans confirmation ni paiement verrouillé
  COMPLETED   // double confirmation faite → vente actée
  CANCELLED
}

enum PaymentType {
  SECURED
  DIRECT
}

enum PaymentStatus {
  NONE
  HELD
  RELEASED
  REFUNDED
}


//fin

enum ProductStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  role               UserRole @default(USER)
  email              String   @unique
  password           String?

  googleId           String?  @unique
  githubId           String? @unique
  
  imageCarteScolaire String?
  cardStatus         CardStatus @default(PENDING)
  cardRejectionReason String?
  createdAt          DateTime @default(now())

  products      Product[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  wishlists Wishlist[]
  reviewsGiven  Review[] @relation("ReviewedBy")
  reviewsReceived Review[] @relation("SellerReviews")
  ordersAsBuyer  Order[] @relation("BuyerOrders")
  ordersAsSeller Order[] @relation("SellerOrders")
  notifications  Notification[]
}

model Category {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products Product[]

}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Decimal
  address     String?
  status      ProductStatus @default(AVAILABLE)   // remplace isSold
  handDelivery Boolean @default(false)
  createdAt   DateTime @default(now())

  seller     User     @relation(fields: [sellerId], references: [id])
  sellerId   Int
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  images     ProductImage[]

  wishlists Wishlist[]
  orders Order[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  createdAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
}


model Message {
  id        Int      @id @default(autoincrement())
  content   String
  timestamp DateTime @default(now())
  isRead    Boolean  @default(false)

  sender     User @relation("SentMessages", fields: [senderId], references: [id])
  senderId   Int
  receiver   User @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId Int
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int

  @@unique([userId, productId]) // empêche les doublons (même produit ajouté 2x)
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  reviewer User @relation("ReviewedBy", fields: [reviewerId], references: [id])
  reviewerId Int
  seller   User @relation("SellerReviews", fields: [sellerId], references: [id])
  sellerId Int

  @@unique([reviewerId, sellerId]) // un seul avis par acheteur par vendeur
}

model Order {
  id        Int         @id @default(autoincrement())
  mode      DeliveryMode @default(DIRECT) // "direct" | "hand_delivery"
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt


  activatedAt DateTime?   // quand cette réservation devient ACTIVE
  expiresAt   DateTime?   // activatedAt + 15min

  paymentType          PaymentType   @default(SECURED)
  paymentStatus        PaymentStatus @default(NONE)
  paymentLockedByStaff Boolean       @default(false)

  buyerConfirmed  Boolean @default(false)
  sellerConfirmed Boolean @default(false)

  buyer     User    @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId   Int
  seller    User    @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerId  Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String // CARD_APPROVED | CARD_REJECTED | ADMIN_MESSAGE
  content   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}
